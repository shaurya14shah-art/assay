{
  "name": "assay",
  "version": "0.1.0",
  "description": "Unit tests for detection rules: prove which ATT&CK techniques your Sigma rules actually catch.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "assay": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
